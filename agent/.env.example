# Per-agent .env for `astra` in angel-agent runtime
# Скопировать в /home/clawdbot/projects/angel-agent/agents/astra/.env
# и заполнить. Этот файл — шаблон, БЕЗ значений.
# Никогда не коммитить заполненный .env в git.

# ─────────────────────────────────────────────────────────
# Telegram channel — REQUIRED
# ─────────────────────────────────────────────────────────
# Используем ТОТ ЖЕ токен, что и production astra-bot из ~/personal-assistant/.env.
# Production astra-bot (PM2 id 66) ДОЛЖЕН быть выключен от long-poll
# до запуска angel-agent daemon, иначе оба будут конкурировать за getUpdates.
TELEGRAM_BOT_TOKEN=

# Только Дарий: numeric Telegram user ID = 87312202
TELEGRAM_ALLOWED_USERS=87312202

# ─────────────────────────────────────────────────────────
# Daemon — REQUIRED
# ─────────────────────────────────────────────────────────
# install.sh сгенерит сам если оставить пустым (preferred).
DAEMON_TOKEN=

# Уникальный порт. Известные:
#   9230 — ultra
#   9241 — astra (наш выбор; если занят — перепроверить ss -tlnp | grep 92)
DAEMON_PORT=9241

DAEMON_BIND=127.0.0.1

# Convention: /var/lib/angel-agent/<name> для system installs.
STATE_DIR=/var/lib/angel-agent/astra

# ─────────────────────────────────────────────────────────
# Identity — REQUIRED
# ─────────────────────────────────────────────────────────
AGENT_NAME=astra
AGENT_PROMPT_PATH=agents/astra/CLAUDE.md

# ─────────────────────────────────────────────────────────
# Speech-to-text — local whisper по умолчанию (русский голос работает)
# ─────────────────────────────────────────────────────────
STT_MODULE=whisper
WHISPER_MODEL=base

# ─────────────────────────────────────────────────────────
# Text-to-speech — edge-tts (cloud, бесплатно, без ключа)
# Опционально — можно отключить через TTS_MODULE=none, если только текст
# ─────────────────────────────────────────────────────────
TTS_MODULE=edge-tts

# ─────────────────────────────────────────────────────────
# Memory — two-layer
# ─────────────────────────────────────────────────────────
# mempalace берёт за основу agent/memory/* (Тёма копирует при setup),
# плюс auto-update через nightly retrospect.
MEMORY_PRIMARY=mempalace
MEMORY_LOG=sqlite

# ─────────────────────────────────────────────────────────
# Telegram polish — опционально
# ─────────────────────────────────────────────────────────
# Стикеры вместо "typing..." — потом подберём, пока пусто
TYPING_STICKERS=

# Меню "/" в Telegram-клиентах
MENU_COMMANDS=start:Привет;status:Статус;help:Что я умею

# ─────────────────────────────────────────────────────────
# Retrospect alerting
# ─────────────────────────────────────────────────────────
AGENT_CHAT_ID=87312202
